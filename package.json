{
  "name": "micron-infotech-fullstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --workspace=server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc --project server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/server.js",
    "test": "node node_modules/vitest/vitest.mjs run server/src/__tests__/api.test.ts",
    "seed": "npm run build:server && node server/dist/scripts/seed.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "^4.67.4",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  }
}
